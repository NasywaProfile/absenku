# Absenku Environment Variables Template

# 1. API Backend (Laravel 11)
VITE_API_URL=/api

# 2. Cloudinary Media Storage (Foto Absensi & Dokumen Tugas)
VITE_CLOUDINARY_CLOUD_NAME=bztonxus
VITE_CLOUDINARY_PRESET=absenku_preset

# 3. Email Notification System
# Opsi 1: Resend (Recommended for Production: 3.000 email/bln free)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Opsi 2: Brevo (Alternatif 300 email/hari free)
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# Opsi 3: Gmail SMTP Fallback
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="in-Time Notifikasi"
